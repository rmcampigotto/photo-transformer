# HTTP
HOST=0.0.0.0
PORT=8080
# Opcional: protege POST /sync (header X-Api-Key ou Authorization: Bearer)
SYNC_API_KEY=
# URL pública do serviço (obrigatória para o Bling baixar as imagens processadas)
# Ex.: https://fotos.seudominio.com.br
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Google Drive — pasta de origem das fotos
GOOGLE_DRIVE_FOLDER_ID=
# Shared Drives / pastas compartilhadas com service account
GOOGLE_SUPPORTS_ALL_DRIVES=true
# Pasta opcional no Drive para gravar JPEGs processados (além de servir via PUBLIC_BASE_URL)
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=

# Auth Google: use SERVICE ACCOUNT **ou** OAuth (client + refresh)
# --- Service account ---
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-sa.json
# --- OAuth (alternativa) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Bling API v3 OAuth2
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=
# Base (padrão produção)
BLING_API_BASE=https://api.bling.com.br/Api/v3
BLING_TOKEN_URL=https://api.bling.com.br/Api/v3/oauth/token

# Processamento
JPEG_QUALITY=90
# true = substitui midia existente; false = anexa URL (Bling pode sobrescrever lista via PATCH)
BLING_REPLACE_MEDIA=true
# Limite de arquivos por sync (0 = sem limite)
SYNC_MAX_FILES=0
